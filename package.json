{
  "name": "second-opinion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hold-and-approve payment guard for Alexa+ (MCP server, risk engine, family approval).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch apps/mcp-server/src/index.ts",
    "start": "tsx apps/mcp-server/src/index.ts",
    "test": "npm run test:node && npm run test:web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm -w @second-opinion/web run typecheck",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "demo": "tsx scripts/demo.ts",
    "start:sim": "tsx apps/simulator/src/index.ts",
    "dev:sim": "tsx watch apps/simulator/src/index.ts",
    "test:node": "node --import tsx --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\" \"eval/test/**/*.test.ts\" \"examples/*/test/**/*.test.ts\"",
    "test:web": "npm -w @second-opinion/web run test",
    "build:web": "npm -w @second-opinion/web run build",
    "dev:web": "npm -w @second-opinion/web run dev",
    "e2e": "playwright test",
    "eval": "tsx eval/run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  }
}
